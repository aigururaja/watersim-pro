# WaterSim Pro — Production Environment Variables
# Copy to .env.prod and fill in real values BEFORE deploying.
# .env.prod is gitignored — NEVER commit it.

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
API_VERSION=v1

# ── Public hostname (used by Nginx + CORS + WS URL) ─────────────────────────
PUBLIC_HOST=app.watersim.example.com
CORS_ORIGIN=https://app.watersim.example.com

# ── Database ─────────────────────────────────────────────────────────────────
# These are used by both the postgres service and the backend service.
POSTGRES_DB=watersim_prod
POSTGRES_USER=watersim
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password

# ── JWT  (minimum 32 chars — use `openssl rand -hex 32`) ────────────────────
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ── DB Pool ───────────────────────────────────────────────────────────────────
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
