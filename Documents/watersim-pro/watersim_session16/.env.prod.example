# WaterSim Pro — Production Environment Variables
# Copy to .env.prod and fill in real values BEFORE deploying.
# .env.prod is gitignored — NEVER commit it.

# ── Container images ────────────────────────────────────────────────────────
# docker-compose.prod.yml interpolates BOTH of these. They are NOT optional:
# without them compose resolves the image to ghcr.io/your-org/watersim-*:latest
# and `docker compose pull` fails with "repository does not exist".
#
#   CI/CD deploys : .github/workflows/cd.yml writes both onto the host, pinning
#                   IMAGE_TAG to the short commit SHA.
#   Manual deploys: if you are BUILDING ON THE HOST rather than pulling from a
#                   registry, set IMAGE_ORG to anything (it only names the local
#                   image) and use `docker compose build`, not `pull`.
#                   See docs/RUNBOOK-deploy.md §9.
IMAGE_ORG=your-github-org
IMAGE_TAG=latest

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
API_VERSION=v1
# error | warn | info | debug — `info` logs every request line
LOG_LEVEL=info

# ── Public hostname (used by Nginx + CORS + WS URL) ─────────────────────────
PUBLIC_HOST=dt.inferconautomation.com
CORS_ORIGIN=https://dt.inferconautomation.com

# ── Database ─────────────────────────────────────────────────────────────────
# WaterSim runs on SQLite by default: one file, no database server. The path
# must be writable by the service user; the file is created on first start.
# (Bare-metal deploys: /opt/watersim/data/watersim.db — see docs/RUNBOOK-deploy-ubuntu.md.)
DATABASE_URL=sqlite:/opt/watersim/data/watersim.db
#
# The POSTGRES_* values below are only used when the backend is pointed at
# PostgreSQL (DB_CLIENT=pg or a postgres:// DATABASE_URL). docker-compose.prod.yml
# still provisions Postgres and overrides DATABASE_URL with a postgres:// URL.
POSTGRES_DB=watersim_prod
POSTGRES_USER=watersim
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password

# ── JWT  (minimum 32 chars — use `openssl rand -hex 32`) ────────────────────
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Live role check ───────────────────────────────────────────────────────────
# On every authenticated request the user's CURRENT role and active flag are
# read from the database (cached per user for ROLE_CACHE_TTL_MS) and override
# the role baked into the access token, so a demotion or deactivation bites
# within the TTL rather than at the next token refresh. If the lookup errors or
# takes longer than ROLE_LOOKUP_TIMEOUT_MS the request proceeds on the token's
# role (fail-open; the miss is cached for the TTL). Deactivation is never
# fail-open: an existing row that says inactive is refused.
ROLE_CACHE_TTL_MS=30000
ROLE_LOOKUP_TIMEOUT_MS=500

# ── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ── DB Pool ───────────────────────────────────────────────────────────────────
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# ── Simulation engine ─────────────────────────────────────────────────────────
# Each run executes in its own worker thread. Keep MAX_CONCURRENT at or below
# the container's cpus: (1.0 in docker-compose.prod.yml) × the vCPUs you gave
# the host, or runs queue behind each other and the wall-clock timeout starts
# firing on work that was merely waiting.
SIMULATION_MAX_CONCURRENT=4
SIMULATION_TIMEOUT_MS=60000

# ── Python report generation ──────────────────────────────────────────────────
# PDF (reportlab + matplotlib) and Excel (openpyxl) are generated by spawning
# Python. The production image installs them and puts python3 on PATH, so
# PYTHON_BIN only needs setting if you have moved it.
# PYTHON_BIN=python3
PY_REPORT_TIMEOUT_MS=30000

# ── PLC integration ───────────────────────────────────────────────────────────
# Leave OFF in production: it permits PLC connections to loopback/private
# addresses, which is an SSRF surface. Turn it on only on an isolated OT network
# where the PLCs genuinely are local to the container host.
PLC_ALLOW_LOCAL_HOSTS=false
PLC_BRIDGE_MAX_CHILDREN=4

# ── Historian (Phase 1) ───────────────────────────────────────────────────────
# Every PLC sample is appended to tag_samples (partitioned by month) and rolled
# into 1-minute and 1-hour buckets. Retention is in days; raw partitions past
# retention are dropped whole. Disk: at a 2 s poll over 340 tags expect
# ~15 M raw rows/day (~1 GB) — set RAW retention to what the disk allows and
# rely on the rollups for anything older.
HISTORIAN_RAW_RETENTION_DAYS=30
HISTORIAN_1M_RETENTION_DAYS=730
HISTORIAN_1H_RETENTION_DAYS=3650
HISTORIAN_ROLLUP_INTERVAL_MS=60000
# The comms-loss alarm sweep (alarm rules of kind 'quality') cadence.
ALARM_QUALITY_SWEEP_MS=5000

# ── Notifications (Phase 2) ──────────────────────────────────────────────────
# WHO receives email and WhatsApp is not set here: every member has their own
# addresses. An admin gives a member a WhatsApp number on invite or edit
# (Admin → Users); a manager sees, edits and tests every member's email and
# WhatsApp for all roles and installs the default policy per role under
# Settings → Notifications → Receivers. Below is only HOW messages are sent.
# Messages are queued in notification_outbox and sent by an in-process worker
# with exponential backoff. Leave a provider unset and its messages go 'dead'
# with the reason shown on the settings page; set NOTIFICATIONS_DRY_RUN=true
# to log instead of send (demos, staging) — never in production.
NOTIFICATIONS_DRY_RUN=false
NOTIFICATIONS_WORKER_INTERVAL_MS=5000
NOTIFICATIONS_MAX_ATTEMPTS=8
# Email over SMTP. The same Gmail account and app password the enterprise
# CRM sends with work here (Google account → Security → 2-Step Verification →
# App passwords); a Gmail user needs no SMTP_HOST. The CRM's names
# (SMTP_PASSWORD, SMTP_FROM_EMAIL, SMTP_FROM_NAME) are accepted as well.
# On a domain of your own, SPF/DKIM on the sending domain or it lands in spam.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WaterSim Pro <no-reply@app.watersim.example.com>"
# WhatsApp through Meta's Cloud API — the WhatsApp Business Account Infercon
# registered for the enterprise CRM (same phone_number_id, same system-user
# token; see docs/RUNBOOK-deploy-ubuntu.md §8.1). Meta delivers plain text only
# within 24 h of the person's last message; every alarm outside that window
# needs an approved UTILITY template with two body parameters ({{1}} subject,
# {{2}} details). Map it here once it is APPROVED — Settings → Notifications
# lists the account's templates with their status.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_TEMPLATES={"*":"watersim_alert"}
WHATSAPP_TEMPLATE_LANG=en_US
# Meta → WhatsApp → Configuration: callback https://<PUBLIC_HOST>/api/v1/webhooks/whatsapp
# with this verify token, subscribed to "messages". The app secret (Meta app
# → App settings → Basic) makes the backend check every webhook's signature.
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_random_string
WHATSAPP_APP_SECRET=
# Twilio's WhatsApp API is the alternative: set WHATSAPP_PROVIDER=twilio (or
# leave the WHATSAPP_* above empty) and fill these in.
# WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
# Links in messages point here; time zone for timestamps in messages.
APP_URL=https://dt.inferconautomation.com
NOTIFY_TZ=Asia/Kolkata

# ── Digital twin (Phase 4) ────────────────────────────────────────────────────
# The server-side twin loop checks every TWIN_TICK_MS which enabled twins are
# due (each has its own cadence) and solves them through the simulation worker
# pool. A PLC sample older than TWIN_MEASUREMENT_FRESH_MS is not merged into
# the model. Equipment counters (run hours, starts, trips) update once a minute.
TWIN_TICK_MS=5000
TWIN_MEASUREMENT_FRESH_MS=300000

# ── CMMS boundary (Phase 5) ───────────────────────────────────────────────────
# Outbound webhooks are signed (HMAC-SHA256) and delivered from the outbox.
# Loopback / private endpoint addresses are refused unless this is true —
# the same SSRF surface as PLC_ALLOW_LOCAL_HOSTS.
WEBHOOK_ALLOW_LOCAL_HOSTS=false
WEBHOOK_TIMEOUT_MS=10000
# The CMMS's own API, for scripts/sync-cmms-assets.js (seeds its asset
# register from the tag registry) — its X-API-Key is set on the CMMS side.
CMMS_URL=http://cmms.internal:8000
CMMS_API_KEY=
