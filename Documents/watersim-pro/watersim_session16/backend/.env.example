# ── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_VERSION=v1

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://watersim:your_password@localhost:5432/watersim_dev
# For tests:
# TEST_DATABASE_URL=postgres://watersim:your_password@localhost:5432/watersim_test

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Auth ─────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=20
