# ── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_VERSION=v1

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:./data/watersim.db
# For tests:
# TEST_DATABASE_URL=sqlite:./data/watersim_test.db   (default: a _test sibling of DATABASE_URL)

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Auth ─────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
# Both OFF at 0 (default). RATE_LIMIT_MAX: all API requests per client IP per window — the app polls, so thousands if set.
# AUTH_RATE_LIMIT_MAX: failed sign-ins per client IP per 15 min (successes, refreshes and the organisation list never count).
RATE_LIMIT_MAX=0
AUTH_RATE_LIMIT_MAX=0

# ── Notifications (email + WhatsApp) ─────────────────────────────────────────
# Dry run logs every message instead of sending it — the default for a dev box.
NOTIFICATIONS_DRY_RUN=true
# Email: a Gmail account with an app password is enough (no SMTP_HOST needed).
SMTP_USER=
SMTP_PASS=
# WhatsApp through Meta's Cloud API — the values from the enterprise CRM's .env.
# Plain text reaches only people who messaged the number in the last 24 h; an
# approved template (two body parameters) reaches everyone. See the runbook §8.1.
# WaterSim's templates are in src/notifications/whatsappTemplates.js:
# `node scripts/whatsapp-templates.js submit` sends them to Meta for review,
# `list` shows their status; map them below once every one is APPROVED.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# WHATSAPP_TEMPLATES={"*":"watersim_alert","alarm.raised":"watersim_alarm_raised","alarm.cleared":"watersim_alarm_cleared","task.":"watersim_task_update"}
# Meta webhook (delivery receipts, replies): callback <APP_URL>/api/v1/webhooks/whatsapp
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Twilio instead: WHATSAPP_PROVIDER=twilio + TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_WHATSAPP_FROM
# Links in messages and the time zone of timestamps in them.
APP_URL=http://localhost:5173
NOTIFY_TZ=Asia/Kolkata
