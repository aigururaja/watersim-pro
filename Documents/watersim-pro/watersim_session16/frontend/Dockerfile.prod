# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────
# WaterSim Pro — Frontend Production Dockerfile (multi-stage)
#
# This is an npm-workspaces monorepo with a SINGLE root package-lock.json.
# Build context MUST be the repo root:
#   docker build -f frontend/Dockerfile.prod .
# (docker-compose.prod.yml and CI/CD already pass context: . )
#
# Stage 1 "builder" : Vite build produces /repo/frontend/dist
#                     (dev deps ARE needed here — vite itself is a devDependency)
# Stage 2 "release" : Nginx serves static assets
# ─────────────────────────────────────────────────────────────

# ── Stage 1: build ───────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /repo

# Root manifest + lockfile + every workspace manifest
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/package.json
COPY frontend/package.json ./frontend/package.json

# Full (dev) install for the frontend workspace — the build needs vite/tailwind
RUN npm ci --workspace=frontend --ignore-scripts

COPY frontend ./frontend

# Build args injected at build time by CI
ARG VITE_API_BASE
ARG VITE_WS_URL
ENV VITE_API_BASE=${VITE_API_BASE}
ENV VITE_WS_URL=${VITE_WS_URL}

RUN npm run build --workspace=frontend

# ── Stage 2: Nginx serving ─────────────────────────────────
FROM nginx:1.27-alpine AS release

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx config (path relative to the repo-root build context)
COPY nginx/frontend.conf /etc/nginx/conf.d/frontend.conf

# Copy Vite build output
COPY --from=builder /repo/frontend/dist /usr/share/nginx/html

# Non-root user (nginx image has user `nginx` with uid 101)
USER nginx

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
