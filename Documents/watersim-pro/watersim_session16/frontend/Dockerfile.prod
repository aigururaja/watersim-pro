# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────
# WaterSim Pro — Frontend Production Dockerfile (multi-stage)
# Stage 1 "builder" : Vite build produces /app/dist
# Stage 2 "release" : Nginx serves static assets
# ─────────────────────────────────────────────────────────────

# ── Stage 1: build ───────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --ignore-scripts

COPY . .

# Build args injected at build time by CI
ARG VITE_API_BASE
ARG VITE_WS_URL
ENV VITE_API_BASE=${VITE_API_BASE}
ENV VITE_WS_URL=${VITE_WS_URL}

RUN npm run build

# ── Stage 2: Nginx serving ─────────────────────────────────
FROM nginx:1.27-alpine AS release

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx config (injected from nginx/frontend.conf)
COPY nginx/frontend.conf /etc/nginx/conf.d/frontend.conf

# Copy Vite build output
COPY --from=builder /app/dist /usr/share/nginx/html

# Non-root user (nginx image has user `nginx` with uid 101)
USER nginx

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
